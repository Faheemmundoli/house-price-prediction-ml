        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "import kagglehub\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.linear_model import LinearRegression\n",
        "from sklearn.metrics import mean_squared_error, r2_score\n",
        "\n",
        "folder = kagglehub.dataset_download(\"heesoo37/120-years-of-olympic-history-athletes-and-results\")\n",
        "df = pd.read_csv(folder + \"/athlete_events.csv\")\n",
        "df['Medal_Binary'] = df['Medal'].notna().astype(int)\n",
        "\n",
        "df_reg = df.dropna(subset=['Height', 'Weight', 'Age'])"
