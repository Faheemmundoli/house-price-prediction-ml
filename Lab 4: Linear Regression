        "## 1. Simple Linear Regression\n",
        "This model tests the direct linear relationship between a single independent variable (Height) and the dependent target variable (Weight). The graph displays the line of best fit through the actual data points."
      ],
      "metadata": {
        "id": "JlGKe_Vy3F9A"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "X_simple = df_reg[['Height']]\n",
        "y_simple = df_reg['Weight']\n",
        "\n",
        "X_train_s, X_test_s, y_train_s, y_test_s = train_test_split(X_simple, y_simple, test_size=0.2, random_state=42)\n",
        "\n",
        "model_simple = LinearRegression()\n",
        "model_simple.fit(X_train_s, y_train_s)\n",
        "\n",
        "y_pred_s = model_simple.predict(X_test_s)\n",
        "\n",
        "print(f\"Coefficient (Slope): {model_simple.coef_[0]:.2f}\")\n",
        "print(f\"Intercept: {model_simple.intercept_:.2f}\")\n",
        "print(f\"Mean Squared Error (MSE): {mean_squared_error(y_test_s, y_pred_s):.2f}\")\n",
        "print(f\"R-squared Score: {r2_score(y_test_s, y_pred_s):.2f}\")\n",
        "\n",
        "plt.figure(figsize=(10, 4))\n",
        "plt.scatter(X_test_s, y_test_s, color='lightgray', alpha=0.5, label='Actual Data')\n",
        "plt.plot(X_test_s, y_pred_s, color='crimson', linewidth=2, label='Regression Line')\n",
        "plt.title('Simple Linear Regression: Predicting Weight from Height')\n",
        "plt.xlabel('Height (cm)')\n",
        "plt.ylabel('Weight (kg)')\n",
        "plt.legend()\n",
        "plt.show()"
      ],
