        "## 2. Multiple Linear Regression\n",
        "This model evaluates how multiple independent variables simultaneously impact the continuous target variable."
      ],
      "metadata": {
        "id": "Wr_82D7f3S9H"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "X_multi = df_reg[['Height', 'Age']]\n",
        "y_multi = df_reg['Weight']\n",
        "\n",
        "X_train_m, X_test_m, y_train_m, y_test_m = train_test_split(X_multi, y_multi, test_size=0.2, random_state=42)\n",
        "\n",
        "model_multi = LinearRegression()\n",
        "model_multi.fit(X_train_m, y_train_m)\n",
        "\n",
        "y_pred_m = model_multi.predict(X_test_m)\n",
        "\n",
        "print(\"Coefficients:\")\n",
        "print(f\"  - Height Impact: {model_multi.coef_[0]:.2f} kg per cm\")\n",
        "print(f\"  - Age Impact: {model_multi.coef_[1]:.2f} kg per year\")\n",
        "print(f\"Intercept: {model_multi.intercept_:.2f}\")\n",
        "print(f\"Mean Squared Error (MSE): {mean_squared_error(y_test_m, y_pred_m):.2f}\")\n",
        "print(f\"R-squared Score: {r2_score(y_test_m, y_pred_m):.2f}\")"
      ],
