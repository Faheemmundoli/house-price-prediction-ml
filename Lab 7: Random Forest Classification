            "\n",
            "    No Medal       0.88      0.61      0.72     35197\n",
            "       Medal       0.18      0.51      0.27      6036\n",
            "\n",
            "    accuracy                           0.60     41233\n",
            "   macro avg       0.53      0.56      0.50     41233\n",
            "weighted avg       0.78      0.60      0.66     41233\n",
            "\n"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "## 3. Comparison with Decision Tree :\n",
        "A single Decision Tree and the Random Forest are trained with the same settings and compared on training and testing accuracy."
      ],
      "metadata": {
        "id": "L662zLE0HooX"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "dt = DecisionTreeClassifier(max_depth=8, class_weight='balanced', random_state=42)\n",
        "dt.fit(X_train, y_train)\n",
        "\n",
        "results = pd.DataFrame({\n",
        "    'Model': ['Decision Tree', 'Random Forest'],\n",
        "    'Train Accuracy': [dt.score(X_train, y_train), rf.score(X_train, y_train)],\n",
        "    'Test Accuracy': [dt.score(X_test, y_test), rf.score(X_test, y_test)]\n",
        "}).round(3)\n",
        "results"
