        "## 5. Effect of Number of Trees :\n",
        "Accuracy is measured for forests with different numbers of trees. More trees generally make the result more stable, up to a point."
      ],
      "metadata": {
        "id": "WDWoDf6rH8Zg"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "n_list = [1, 5, 10, 25, 50, 100]\n",
        "test_acc = []\n",
        "\n",
        "for n in n_list:\n",
        "    m = RandomForestClassifier(n_estimators=n, max_depth=8, class_weight='balanced', random_state=42, n_jobs=-1)\n",
        "    m.fit(X_train, y_train)\n",
        "    test_acc.append(m.score(X_test, y_test))\n",
        "\n",
        "plt.figure(figsize=(10, 5))\n",
        "plt.plot(n_list, test_acc, marker='o', color='crimson')\n",
        "plt.title('Effect of Number of Trees on Test Accuracy', fontsize=14)\n",
        "plt.xlabel('n_estimators')\n",
        "plt.ylabel('Test Accuracy')\n",
        "plt.grid(alpha=0.3)\n",
        "plt.show()"
